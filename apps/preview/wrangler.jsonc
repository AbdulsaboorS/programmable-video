{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "programmable-video-preview",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "STUDIO_ORIGIN": "https://programmable-video-studio.example.workers.dev",
  },
  "r2_buckets": [
    {
      "binding": "REVISION_PREVIEWS",
      "bucket_name": "programmable-video-previews",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
