{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "programmable-video-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BUILD_ID": "development",
    "ACCESS_AUD": "replace-with-access-audience",
    "ACCESS_TEAM_DOMAIN": "https://example.cloudflareaccess.com",
    "PREVIEW_ORIGIN": "https://programmable-video-preview.example.workers.dev",
    "STUDIO_ORIGIN": "https://programmable-video-studio.example.workers.dev",
  },
  "assets": {
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "stream": {
    "binding": "STREAM",
  },
  "d1_databases": [
    {
      "binding": "PROJECTS_DB",
      "database_name": "programmable-video-projects",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REVISION_SOURCES",
      "bucket_name": "programmable-video-revision-sources",
    },
    {
      "binding": "REVISION_PREVIEWS",
      "bucket_name": "programmable-video-previews",
    },
    {
      "binding": "PROJECT_REFERENCES",
      "bucket_name": "programmable-video-references",
    },
    {
      "binding": "PROJECT_MEDIA",
      "bucket_name": "programmable-video-media",
    },
  ],
  "workflows": [
    {
      "name": "studio-render-workflow",
      "binding": "RENDER_WORKFLOW",
      "class_name": "RenderWorkflow",
    },
    {
      "name": "studio-revision-workflow",
      "binding": "REVISION_WORKFLOW",
      "class_name": "RevisionWorkflow",
    },
    {
      "name": "studio-managed-render-workflow",
      "binding": "MANAGED_RENDER_WORKFLOW",
      "class_name": "ManagedRenderWorkflow",
    },
  ],
  "containers": [
    {
      "class_name": "RendererContainer",
      "image": "../renderer/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 1,
    },
    {
      "class_name": "Sandbox",
      "image": "./Sandbox.Dockerfile",
      "instance_type": "basic",
      "max_instances": 2,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDERER",
        "class_name": "RendererContainer",
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RendererContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"],
    },
  ],
}
